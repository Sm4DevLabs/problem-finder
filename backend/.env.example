# Backend configuration for ProblemFinder (copy to `.env` and adjust as needed).

# Async SQLAlchemy connection string (psycopg v3 driver).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://problemfinder:problemfinder@localhost:5432/problemfinder

# Local Ollama server used for AI source assessment and problem enrichment.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# CMS-aware scraping API (has a working default, override if self-hosting).
CRAWLVIEL_API_URL=https://crawlviel-api.sm4devlabs.dpdns.org
