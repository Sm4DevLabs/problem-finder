# Backend configuration for ProblemFinder (copy to `.env` and adjust as needed).

# Async SQLAlchemy connection string (psycopg v3 driver).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://problemfinder:problemfinder@localhost:5432/problemfinder

# Local Ollama server used for AI source assessment and problem enrichment.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# CMS-aware scraping API (has a working default, override if self-hosting).
CRAWLVIEL_API_URL=https://crawlviel-api.sm4devlabs.dpdns.org

# --- Connector credentials (app/connectors/adapters/) ---
# Most adapters (Hacker News, Stack Exchange, CFPB, NYC 311, Civic Tech Field
# Guide, NASA Space Apps, Open Government Partnership, DrivenData, ProblemHunt,
# Razorpay, Indie Hackers) need no credentials at all. The ones below do.

# Reddit — required. Free, self-serve: log into Reddit, open
# https://www.reddit.com/prefs/apps, click "create app", type "script",
# any redirect URI (e.g. http://localhost:8080).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=ProblemFinder/1.0 (by /u/your-username)
# REDDIT_SUBREDDITS=SomebodyMakeThis,Lightbulb,AppIdeas

# Kaggle Competitions — required. Free, self-serve: log into Kaggle, open
# https://www.kaggle.com/settings/account, API section, "Create New Token".
KAGGLE_USERNAME=
KAGGLE_KEY=

# Stack Exchange — optional. Raises the anonymous 300/day quota to 10,000/day.
# Free, self-serve: https://stackapps.com/apps/oauth/register
# STACKEXCHANGE_KEY=
# STACKEXCHANGE_SITE=softwarerecs

# NYC 311 — optional. Raises Socrata's anonymous throttling limit.
# Free, self-serve: https://data.cityofnewyork.us/profile/edit/developer_settings
# NYC_311_APP_TOKEN=

# Lobsters — disabled by default. lobste.rs/robots.txt disallows
# non-allowlisted crawlers; do not set this unless you have obtained
# explicit, out-of-band permission from the Lobsters maintainers.
# LOBSTERS_IGNORE_ROBOTS=true
